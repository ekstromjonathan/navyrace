# Linq (from `linq tokens show` or dashboard)
LINQ_API_TOKEN=
# Required for a permanent HTTPS webhook. Leave empty when using
# `linq webhooks listen --forward-to http://localhost:8787/webhook`
LINQ_WEBHOOK_SECRET=
LINQ_ALLOWLIST=+4740343295
# PT iMessage line — name + photo are applied to this number.
LINQ_FROM_NUMBER=+14044465379
# Optional override; default is https://lodd.ai/pt-avatar.png
# LINQ_CONTACT_IMAGE_URL=https://lodd.ai/pt-avatar.png

# LLM — OpenRouter preferred (bills OpenRouter, not Anthropic directly)
OPENROUTER_API_KEY=
# Fallback if OpenRouter is unset:
ANTHROPIC_API_KEY=
PT_MODEL=x-ai/grok-4.3
# Programmer hat (plans / heavier reasoning)
PT_MODEL_SMART=x-ai/grok-4.6

# PT journal — Supabase (production). Secret / service role only; anon has no grants on pt.*.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# New API keys (preferred): Project Settings → API Keys → Secret keys (sb_secret_…)
SUPABASE_SECRET_KEY=
# Legacy alias (JWT service_role under "Legacy API Keys" tab) — still accepted:
# SUPABASE_SERVICE_ROLE_KEY=
# Optional alias if SUPABASE_URL is unset:
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Local/unit-test fallback when Supabase creds are unset:
# PT_DB_PATH=./data/journal.sqlite
