# Linq (from `linq tokens show` or dashboard)
LINQ_API_TOKEN=
# Required for a permanent HTTPS webhook. Leave empty when using
# `linq webhooks listen --forward-to http://localhost:8787/webhook`
LINQ_WEBHOOK_SECRET=
LINQ_ALLOWLIST=+4740343295

# LLM — OpenRouter preferred (bills OpenRouter, not Anthropic directly)
OPENROUTER_API_KEY=
# Fallback if OpenRouter is unset:
ANTHROPIC_API_KEY=
PT_MODEL=x-ai/grok-4.3
# Programmer hat (plans / heavier reasoning)
PT_MODEL_SMART=x-ai/grok-4.6

PT_PORT=8787
# Railway sets PORT. Bind all interfaces in hosted environments.
PT_HOST=0.0.0.0
PT_TZ=Europe/Oslo
PT_COACH_NAME=lodd.ai
PT_DB_PATH=./data/journal.sqlite
